.head {
  padding: 32rpx;
  background: linear-gradient(160deg, #f7f2e6, #fbf7ee);
}

.head-row {
  display: flex;
  align-items: center;
}

.head-text {
  flex: 1;
  min-width: 0;
}

.head-title {
  font-size: 44rpx;
  font-weight: 800;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.head-ring {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 6rpx solid #e5efe9;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.head-pct {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--jade);
}

.head-progress {
  margin-top: 26rpx;
}

.head-actions {
  display: flex;
  margin-top: 24rpx;
}

.mini-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #4a9c8b, var(--jade));
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(62, 142, 126, 0.2);
}

.mini-btn + .mini-btn {
  margin-left: 20rpx;
}

.mini-btn.ghost {
  background: #ffffff;
  color: var(--jade-deep);
  border: 2rpx solid #dfeae5;
  box-shadow: none;
}

.units {
  padding: 8rpx 32rpx 0;
}

.unit {
  margin-bottom: 28rpx;
  padding: 26rpx 24rpx 10rpx;
  background: #ffffff;
  border-radius: 30rpx;
  border: 2rpx solid rgba(233, 223, 205, 0.7);
  box-shadow: 0 8rpx 22rpx rgba(81, 66, 37, 0.045);
}

.unit-head {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed #f0e8d8;
  margin-bottom: 6rpx;
}

.unit-dot {
  width: 12rpx;
  height: 44rpx;
  border-radius: 6rpx;
  margin-right: 18rpx;
}

.unit-title {
  font-size: 29rpx;
  font-weight: 700;
}

.unit-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.unit-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--jade);
}

.lessons {
  padding-top: 4rpx;
}

.lesson {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx;
  border-bottom: 2rpx solid #faf6ee;
}

.lesson:last-child {
  border-bottom: none;
}

.lesson-no {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border-radius: 14rpx;
  background: #f6f1e5;
  color: var(--ink-2);
  font-size: 23rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lesson.done .lesson-no {
  background: var(--jade-soft);
  color: var(--jade-deep);
}

.lesson-body {
  flex: 1;
  min-width: 0;
}

.lesson-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lesson-kind {
  flex: none;
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #f6f1e5;
  color: #a08b62;
  font-size: 19rpx;
  font-weight: 500;
}

.lesson-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.lesson-state {
  flex: none;
  width: 48rpx;
  text-align: right;
}

.check {
  color: var(--jade);
  font-size: 30rpx;
  font-weight: 800;
}

.arrow {
  color: #cfc6b5;
  font-size: 36rpx;
}
