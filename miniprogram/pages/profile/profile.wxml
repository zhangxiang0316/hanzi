<view class="page">
  <view class="head">
    <view class="avatar">🐣</view>
    <view class="head-info">
      <view class="head-name">{{profileName}}</view>
      <view class="head-sub">已学习 {{days}} 天 · 连续 {{streak}} 天</view>
    </view>
  </view>

  <!-- 多孩子档案：一间屋里两个孩子共用一个平板是常态，
       数据必须分开，否则弟弟写几个字就把哥哥的进度搅乱了 -->
  <view class="section-head">
    <view class="section-title">孩子</view>
    <view class="section-sub" wx:if="{{profileCount > 1}}">各用各的进度</view>
  </view>
  <view class="profile-box">
    <view class="profile-row">
      <view
        class="profile-chip {{activeProfileId === item.id ? 'on' : ''}}"
        wx:for="{{profiles}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSwitchProfile"
      >{{item.name}}</view>
      <view class="profile-chip add" wx:if="{{canAddProfile}}" bindtap="onAddProfile">＋</view>
    </view>
    <view class="profile-tools" wx:if="{{profileCount > 1}}">
      <text class="profile-tool tap" bindtap="onRenameProfile">改名</text>
      <text class="profile-tool tap danger" bindtap="onRemoveProfile">删除这个孩子</text>
    </view>
  </view>

  <view class="overview">
    <view class="ov-item">
      <text class="ov-num">{{learned}}</text>
      <text class="ov-label">学过的字</text>
    </view>
    <view class="ov-line"></view>
    <view class="ov-item">
      <text class="ov-num">{{mastered}}</text>
      <text class="ov-label">已掌握</text>
    </view>
    <view class="ov-line"></view>
    <view class="ov-item">
      <text class="ov-num">{{writeStars}}</text>
      <text class="ov-label">描红星</text>
    </view>
  </view>

  <view class="total-card">
    <view class="total-top">
      <text class="total-title">{{gradeSpan}} {{total}} 字</text>
      <text class="total-pct">{{pct}}%</text>
    </view>
    <view class="progress">
      <view class="progress-fill" style="width: {{pct}}%"></view>
    </view>
    <view class="total-desc">每天 5 个字，坚持 {{daysNeeded}} 天就能全部学完</view>
  </view>

  <view class="section-head">
    <view class="section-title">我的徽章</view>
    <view class="section-sub">{{badgeGot}}/{{badges.length}}</view>
  </view>
  <view class="badges">
    <view class="badge {{item.got ? 'got' : ''}}" wx:for="{{badges}}" wx:key="id">
      <text class="badge-emoji">{{item.got ? item.emoji : '🔒'}}</text>
      <text class="badge-name">{{item.name}}</text>
      <text class="badge-desc">{{item.desc}}</text>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">学习设置</view>
  </view>
  <view class="settings">
    <view class="setting">
      <view class="setting-label">每天新学</view>
      <view class="seg">
        <view
          class="seg-item {{dailyNew === item ? 'on' : ''}}"
          wx:for="{{dailyOptions}}"
          wx:key="*this"
          data-n="{{item}}"
          bindtap="onDaily"
        >{{item}} 字</view>
      </view>
    </view>
    <view class="setting setting-col">
      <view class="setting-label">当前册次</view>
      <view class="seg seg-grid">
        <view
          class="seg-item {{book === item.id ? 'on' : ''}}"
          wx:for="{{books}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onBook"
        >{{item.short}}</view>
      </view>
    </view>
    <view class="setting">
      <view class="setting-label">显示组词拼音</view>
      <switch checked="{{showPinyin}}" color="#3E8E7E" bindchange="onPinyin" />
    </view>
  </view>

  <view class="links">
    <!-- 周报：首页只看得到「今天」，家长关心的是「这一周」 -->
    <view class="link tap" bindtap="onReport">
      <text class="link-name">学习周报</text>
      <text class="link-value">最近 7 天 ›</text>
    </view>
    <view class="link tap" bindtap="onVocab">
      <text class="link-name">识字量测试</text>
      <text class="link-value">{{vocabSize > 0 ? '上次 ' + vocabText + ' 字 ›' : '测一测 ›'}}</text>
    </view>
    <view class="link tap" bindtap="onWrong">
      <text class="link-name">错题本</text>
      <text class="link-value">{{wrongCount}} 个字 ›</text>
    </view>
    <!-- 字帖：写出来的字和认得的字是两种能力，值得单独有一个入口。
         徽章体系几乎全是「认识 N 个字」，写字这个维度此前只有单字页里的三颗星。 -->
    <view class="link tap" bindtap="onCopybook">
      <text class="link-name">我的字帖</text>
      <text class="link-value">{{writeCount > 0 ? writeCount + ' 个字 ›' : '还没写过 ›'}}</text>
    </view>
    <!-- 选字做字帖：「我的字帖」只能导写过的字，而家长想打的是"这课的生字""错题" -->
    <view class="link tap" bindtap="onCopybookPick">
      <text class="link-name">选字做字帖</text>
      <text class="link-value">按课时 / 错题挑字 ›</text>
    </view>
    <!-- 部首与词语：两种"换个角度看字"的浏览方式 -->
    <view class="link tap" bindtap="onRadical">
      <text class="link-name">部首归类</text>
      <text class="link-value">按部首看字 ›</text>
    </view>
    <view class="link tap" bindtap="onWords">
      <text class="link-name">词语表</text>
      <text class="link-value">按册翻词语 ›</text>
    </view>
    <view class="link tap" bindtap="onAbout">
      <text class="link-name">关于与数据来源</text>
      <text class="link-value">›</text>
    </view>
    <view class="link tap" bindtap="onReset">
      <text class="link-name danger">清空学习记录</text>
      <text class="link-value">›</text>
    </view>
  </view>

  <view class="footer">小小识字家 v{{version}} · 内容仅供学习使用</view>

  <view class="safe-bottom"></view>
</view>
