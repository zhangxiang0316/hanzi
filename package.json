{
  "name": "hanzi-kids",
  "version": "1.0.0",
  "private": true,
  "description": "小小识字家 —— 面向小学一二年级的汉字学习微信小程序",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:icons": "node scripts/gen-icons.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/",
    "render:check": "node scripts/render-check.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:shots": "node scripts/preview.mjs --shots",
    "check": "npm run build:data && npm run lint && npm test && npm run render:check"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "puppeteer-core": "^24.43.1"
  }
}
