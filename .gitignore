# ---- Android 原生工程 ----
# Android Studio 的个人配置（workspace.xml 里是窗口布局、最近打开的文件等）
android/.idea/
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/release/
*.apk
*.aab
# dist/ 下是刻意发布的成品包，供直接下载安装；其余位置的 APK/AAB 一律忽略
!android/dist/*.apk
# 只忽略发布密钥；debug.keystore 是公开的调试密钥，进仓库才能「克隆即可构建」
*.jks
android/keystore/release.*
*.keystore
!android/keystore/debug.keystore

# 站内工具链（Gradle 发行版 + 依赖缓存 + Robolectric 字体/依赖），体积很大，不进仓库
.tools/
