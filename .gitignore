# ---- Android 原生工程 ----
# Android Studio 的个人配置（workspace.xml 里是窗口布局、最近打开的文件等）
android/.idea/
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/release/
*.apk
*.aab
# dist/ 下是刻意发布的成品包，供直接下载安装；其余位置的 APK/AAB 一律忽略
!android/dist/*.apk
# 只忽略发布密钥；debug.keystore 是公开的调试密钥，进仓库才能「克隆即可构建」
*.jks
android/keystore/release.*
*.keystore
!android/keystore/debug.keystore

# 站内工具链（Gradle 发行版 + 依赖缓存 + Robolectric 字体/依赖），体积很大，不进仓库
.tools/

# ---- iOS 原生工程 ----
# Xcode / 构建产物。`.build*` 覆盖 .build、.build-land、.build-mini 等
# 为验证不同尺寸/方向临时建的派生目录——曾经因为只写了 `.build/`，
# 另外两个目录被一起提交进了历史。
ios/.build*/
ios/DerivedData/

# JetBrains / 编辑器
.idea/
*.xcuserstate
ios/HanziPad.xcodeproj/xcuserdata/
ios/HanziPad.xcodeproj/project.xcworkspace/xcuserdata/
